<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Compile Include="../../Repilot/Models/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../../Repilot/Services/ActionExecutor.cs" Link="Shared/ActionExecutor.cs" />
    <Compile Include="../../Repilot/Services/ActionSummary.cs" Link="Shared/ActionSummary.cs" />
    <Compile Include="../../Repilot/Services/WindowsFunctionCatalog.cs" Link="Shared/WindowsFunctionCatalog.cs" />
  </ItemGroup>
</Project>
